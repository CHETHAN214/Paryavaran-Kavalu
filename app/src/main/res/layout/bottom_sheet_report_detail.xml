<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingBottom="40dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/tv_waste_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pending"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/iv_photo"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:contentDescription="Report photo" />

    <!-- GPS Coords -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_box"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GPS COORDINATES" android:textColor="@color/text_muted"
            android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tv_coords"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/green_deep" android:textSize="14sp"
            android:textStyle="bold" android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_info_box"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginEnd="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SEVERITY" android:textColor="@color/text_muted"
                android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_severity"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_dark" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_info_box"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginStart="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="REPORTED" android:textColor="@color/text_muted"
                android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_reported_time"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_dark" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_box"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DESCRIPTION" android:textColor="@color/text_muted"
            android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tv_description"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_dark" android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_mark_cleaned"
        style="@style/Widget.ParyavaranKavalu.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="✅ Mark as Cleaned (+5 Eco-Karma)" />

    <TextView
        android:id="@+id/tv_already_cleaned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="✅ This spot has been cleaned!"
        android:textColor="@color/green_main"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
