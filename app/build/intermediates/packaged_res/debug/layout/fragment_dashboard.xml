<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HERO CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR ECO-KARMA POINTS"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_karma_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_level_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level 1 — Seedling Guardian"
                android:textColor="#CCFFFFff"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <!-- Streak row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tv_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_streak_chip"
                    android:text="🔥 1 day streak"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_chip_reports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_streak_chip"
                    android:text="📍 0 reports"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_chip_cleaned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_streak_chip"
                    android:text="✅ 0 cleaned"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- STATS GRID -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginBottom="16dp"
            android:useDefaultMargins="false">

            <!-- Pending -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PENDING REPORTS" android:textColor="@color/text_muted"
                    android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_stat_pending" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/red" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Needs attention" android:textColor="@color/red" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Cleaned -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CLEANED SPOTS" android:textColor="@color/text_muted"
                    android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_stat_cleaned" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/green_main" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Great work!" android:textColor="@color/green_main" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Rate -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CLEANUP RATE" android:textColor="@color/text_muted"
                    android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_stat_rate" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0%"
                    android:textColor="@color/amber" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="of reported spots" android:textColor="@color/text_muted" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Rank -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="YOUR RANK" android:textColor="@color/text_muted"
                    android:textSize="10sp" android:letterSpacing="0.05" android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#4"
                    android:textColor="@color/green_main" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="in your area" android:textColor="@color/green_main" android:textSize="11sp"/>
            </LinearLayout>

        </GridLayout>

        <!-- RECENT REPORTS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECENT REPORTS"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="visible">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🌱" android:textSize="48sp" android:layout_marginBottom="12dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="No reports yet. Be the first to report a waste blackspot!"
                android:textColor="@color/text_muted" android:textSize="14sp" android:gravity="center" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_reports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_report_new"
            style="@style/Widget.ParyavaranKavalu.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="＋ Report New Waste Blackspot" />

    </LinearLayout>
</ScrollView>
