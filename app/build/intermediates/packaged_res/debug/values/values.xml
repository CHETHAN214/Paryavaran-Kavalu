<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="amber">#f39c12</color>
    <color name="border_light">#e8f4ed</color>
    <color name="colorOnPrimary">#FFFFFF</color>
    <color name="colorPrimary">#1a7a4a</color>
    <color name="colorPrimaryVariant">#0f4d2a</color>
    <color name="earth">#8b5e3c</color>
    <color name="earth_light">#c4956a</color>
    <color name="gray">#95a5a6</color>
    <color name="gray_dark">#2c3e50</color>
    <color name="gray_light">#ecf0f1</color>
    <color name="green_deep">#0f4d2a</color>
    <color name="green_light">#2ecc71</color>
    <color name="green_main">#1a7a4a</color>
    <color name="green_pale">#d4f5e2</color>
    <color name="off_white">#f8fdf9</color>
    <color name="rank_bronze">#e67e22</color>
    <color name="rank_gold">#f1c40f</color>
    <color name="rank_silver">#bdc3c7</color>
    <color name="red">#e74c3c</color>
    <color name="sky">#3498db</color>
    <color name="status_cleaned_bg">#d4f5e2</color>
    <color name="status_pending_bg">#fde8e6</color>
    <color name="text_dark">#1a2e1f</color>
    <color name="text_muted">#627a6b</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Paryavaran-Kavalu</string>
    <string name="get_gps">Get GPS</string>
    <string name="mark_cleaned">✓ Mark Cleaned</string>
    <string name="submit_report">📤 Submit Report</string>
    <string name="tab_home">Home</string>
    <string name="tab_karma">Karma</string>
    <string name="tab_map">Map</string>
    <string name="tab_report">Report</string>
    <style name="Theme.ParyavaranKavalu" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/green_main</item>
        <item name="colorPrimaryVariant">@color/green_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green_light</item>
        <item name="colorSecondaryVariant">@color/green_pale</item>
        <item name="android:statusBarColor">@color/green_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.ParyavaranKavalu.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@color/green_deep</item>
        <item name="android:navigationBarColor">@color/green_main</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Widget.ParyavaranKavalu.GpsButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_gps_btn</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.ParyavaranKavalu.MarkCleanedButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:background">@drawable/bg_mark_cleaned_btn</item>
        <item name="android:textColor">@color/green_main</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.ParyavaranKavalu.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_primary_btn</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">4dp</item>
    </style>
    <style name="Widget.ParyavaranKavalu.SeverityButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/selector_severity_btn</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.ParyavaranKavalu.TabButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:background">@drawable/selector_tab_btn</item>
        <item name="android:textColor">@drawable/selector_tab_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/green_pale</item>
    </style>
    <style name="Widget.ParyavaranKavalu.WasteChip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/selector_waste_chip</item>
        <item name="android:textColor">@drawable/selector_waste_chip_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/border_light</item>
    </style>
</resources>